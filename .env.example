# Optional — enables Google Places autocomplete + details server routes.
# Either works (routes check GOOGLE_MAPS_API_KEY first, then GOOGLE_PLACES_API_KEY).
GOOGLE_MAPS_API_KEY=
# GOOGLE_PLACES_API_KEY=

# Optional — enables AI Insights beyond deterministic bullets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional — PayrollTaxAPI (https://payrolltaxapi.com). Server-side only; never expose to the client.
# When set, comparison uses live rate lookups (annual pay period) instead of the built-in demo estimator.
PAYROLL_TAX_API_KEY=
