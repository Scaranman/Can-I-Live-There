# Optional — enables Google Places autocomplete + details server routes.
# Either works (routes check GOOGLE_MAPS_API_KEY first, then GOOGLE_PLACES_API_KEY).
GOOGLE_MAPS_API_KEY=
# GOOGLE_PLACES_API_KEY=

# Optional — enables AI Insights beyond deterministic bullets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional — PayrollTaxAPI (https://payrolltaxapi.com). Server-side only; never expose to the client.
# When set, comparison uses live rate lookups (annual pay period) instead of the built-in demo estimator.
PAYROLL_TAX_API_KEY=

# Optional — Canada columns use canatax via Python when available (see requirements.txt + scripts/canatax_estimate.py).
# Examples: python3, python, py, or full path. On hosts without Python/canatax, Canada uses a rough built-in demo instead.
# CANATAX_PYTHON=

# Optional — ExchangeRate-API (https://www.exchangerate-api.com/) for USD↔CAD when comparing US and Canadian columns.
# Without a key, the app uses the public open.er-api.com feed, then a static fallback if that fails.
# EXCHANGERATE_API_KEY=
